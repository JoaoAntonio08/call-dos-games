# Copie para .env e preencha. Nunca suba o .env para o git.

# Postgres (veja deploy/postgres.sql)
DATABASE_URL=postgresql://cdg:TROQUE_A_SENHA@127.0.0.1:5432/calldosgames

# 32+ caracteres aleatórios. Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Endereço público desta API (é usado nos links das imagens e sons)
PUBLIC_URL=https://api.cdg.exemplo.com
# Onde está o site. Usado nos links de convite e de redefinir senha
FRONTEND_URL=https://cdg.exemplo.com
# Quem pode chamar a API pelo navegador (separe por vírgula)
CORS_ORIGINS=https://cdg.exemplo.com

# Pasta das fotos, banners, sons e anexos (faça backup dela junto com o banco)
UPLOAD_DIR=/var/lib/calldosgames/uploads

# LiveKit: Cloud (wss://xxx.livekit.cloud) ou o seu (wss://voz.exemplo.com)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Opcional: login com Google (só o Client ID, o "secret" não é usado)
GOOGLE_CLIENT_ID=

# Opcional: e-mail de "esqueci a senha" pelo Resend. Sem isso o link aparece no log da API
RESEND_API_KEY=
EMAIL_FROM=

# Opcional: busca de GIFs no chat (chave grátis em developers.giphy.com)
GIPHY_API_KEY=
# Opcional: "jogando agora" e jogos recentes da Steam (chave grátis em steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# 1 quando a API fica atrás da Cloudflare (nuvem laranja): o limite de tentativas de login usa o IP real
BEHIND_CLOUDFLARE=1
# Tentativas de login/cadastro por IP a cada 10 minutos
AUTH_RATE_LIMIT=20
