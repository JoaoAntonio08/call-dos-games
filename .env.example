# Configuração do site. Copie para .env.local e preencha.
# No servidor: /opt/calldosgames/app/.env.local (veja backend/DEPLOY.md).

# Endereço da API (backend/). Entra no build: depois de mudar, rode o build de novo.
NEXT_PUBLIC_API_URL=https://api.cdg.exemplo.com

# LiveKit: os mesmos valores do backend/.env (a call rápida /sala/... usa daqui)
# LiveKit Cloud: Settings > Keys. Próprio: wss://voz.cdg.exemplo.com
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
